# Copy to .env for local development: cp .env.example .env
APP_ENV=development
LOG_LEVEL=debug
LOG_FORMAT=text

HTTP_ADDR=:8080
ADMIN_ADDR=:9090
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

DATABASE_URL=postgres://renora:renora@localhost:55432/renora?sslmode=disable
REDIS_URL=redis://localhost:56379/0

GRAPHQL_COMPLEXITY_LIMIT=1000
GRAPHQL_DEPTH_LIMIT=12

# Leave empty to keep tracing off locally.
OTEL_EXPORTER_OTLP_ENDPOINT=
