"""
RFC 3339 timestamp in UTC.
"""
scalar Time

"""
An object with a globally unique ID that can be refetched.
"""
interface Node {
  id: ID!
}

"""
Cursor pagination info (Relay connection spec).
"""
type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
}

"""
A problem with mutation input that the user can fix. Mutations return these
in their payload; unexpected failures come back as top-level errors instead.
"""
type UserError {
  code: UserErrorCode!
  message: String!
  "Path to the input field, e.g. [\"input\", \"stages\", \"2\", \"amount\"]."
  field: [String!]
}

enum UserErrorCode {
  INVALID_INPUT
  CONFLICT
  NOT_FOUND
  FORBIDDEN
}

type ServerInfo {
  version: String!
  time: Time!
}

type Query {
  "Build version and server clock. Clients use the clock to detect device time drift."
  serverInfo: ServerInfo!
}
